generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Publisher {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  name        String    @unique
  slug        String    @unique @db.VarChar(100)
  website     String?
  type        String    @default("nxb") @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  comics      Comic[]
  events      Event[]
  volumes     Volume[]

  @@map("publishers")
}

model Comic {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  publisherId   String    @map("publisher_id")
  publisher     Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  title         String    @db.VarChar(500)
  slug          String    @unique(map: "comics_slug_unique_idx") @db.VarChar(500)
  productId     String?   @unique @map("product_id")
  sku           String?   @db.VarChar(100)
  isbn          String?   @db.VarChar(50)

  price         Int?
  originalPrice Int?      @map("original_price")
  currency      String    @default("VND") @db.VarChar(10)

  authors       String[]
  targetAudience String?  @map("target_audience")
  dimensions    String?
  pages         Int?
  format        String?
  weight        String?

  editionType   String?   @default("ban_in_dau") @map("edition_type") @db.VarChar(50)
  editionYear   Int?      @map("edition_year")

  series        String?
  description   String?
  coverImage    String?   @map("cover_image")
  productType   String?   @map("product_type") @db.VarChar(50)
  url           String?   @unique
  lastmod       String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  eventGifts    EventGift[]
  listings      Listing[]
  volumes       Volume[]

  @@index([slug])
  @@index([title])
  @@index([productId])
  @@index([publisherId])
  @@map("comics")
}

model Volume {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  comicId       String    @map("comic_id")
  comic         Comic     @relation(fields: [comicId], references: [id], onDelete: Cascade)

  publisherId   String?   @map("publisher_id")
  publisher     Publisher? @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  title         String    @db.VarChar(500)
  slug          String    @db.VarChar(500)
  productId     String?   @unique @map("product_id")
  sku           String?   @db.VarChar(100)
  barcode       String?   @db.VarChar(100)

  price         Int?
  originalPrice Int?      @map("original_price")
  currency      String    @default("VND") @db.VarChar(10)

  volumeNumber  Int?      @map("volume_number")
  volumeLabel   String?   @map("volume_label") @db.VarChar(50)

  pages         Int?
  format        String?   @db.VarChar(50)
  dimensions    String?   @db.VarChar(50)
  weight        String?   @db.VarChar(50)

  coverImage    String?   @map("cover_image")
  url           String?   @unique

  available     Boolean   @default(true)
  inventoryQty  Int?      @map("inventory_qty")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @map("updated_at")

  eventGifts    EventGift[]
  gifts         Gift[]
  listings      Listing[]

  @@index([slug])
  @@index([productId])
  @@index([comicId])
  @@index([publisherId])
  @@map("volumes")
}

model Gift {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  name        String    @db.VarChar(200)
  description String?
  imageUrl    String?   @map("image_url")
  isFes       Boolean   @default(false) @map("is_fes")
  fesEvent    String?   @map("fes_event") @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  volumeId    String?   @map("volume_id")
  volume      Volume?   @relation(fields: [volumeId], references: [id], onDelete: SetNull)
  eventId     String?   @map("event_id")
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  giftType    String    @default("combo") @map("gift_type") @db.VarChar(50)
  rarity      String    @default("normal") @db.VarChar(50)
  eventGifts  EventGift[]
  listings    Listing[]

  @@index([volumeId])
  @@index([eventId])
  @@map("gifts")
}

model Event {
  id           String    @id @default(dbgenerated("gen_random_uuid()"))
  publisherId  String    @map("publisher_id")
  publisher    Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  name         String    @db.VarChar(200)
  eventType    String    @default("hoc_sach") @map("event_type") @db.VarChar(50)
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  description  String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  eventGifts   EventGift[]
  gifts        Gift[]

  @@index([publisherId])
  @@map("events")
}

model EventGift {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  eventId    String
  comicId    String?   @map("comic_id")
  giftName   String    @map("gift_name") @db.VarChar(200)
  condition  String?
  imageUrl   String?   @map("image_url")
  createdAt  DateTime  @default(now()) @map("created_at")
  volumeId   String?   @map("volume_id")
  giftId     String?   @map("gift_id")
  comic      Comic?    @relation(fields: [comicId], references: [id])
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gift       Gift?     @relation(fields: [giftId], references: [id])
  volume     Volume?   @relation(fields: [volumeId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([comicId])
  @@index([giftId])
  @@index([volumeId])
  @@map("event_gifts")
}

model User {
  id         String    @id @default(dbgenerated("gen_random_uuid()"))
  email      String?   @unique
  name       String?
  image      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  listings   Listing[]

  @@map("users")
}

model Listing {
  id            String   @id @default(dbgenerated("gen_random_uuid()"))
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  comicId       String   @map("comic_id")
  comic         Comic    @relation(fields: [comicId], references: [id], onDelete: Cascade)

  volumeId      String?  @map("volume_id")
  volume        Volume?  @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  giftId        String?  @map("gift_id")
  gift          Gift?    @relation(fields: [giftId], references: [id], onDelete: Cascade)

  listingType   String   @default("volume") @map("listing_type") @db.VarChar(20)
  price         Int
  condition     String   @default("tot") @db.VarChar(50)
  editionInfo   String?  @map("edition_info")
  giftsIncluded String[] @map("gifts_included")
  intro         String?
  outro         String?
  status        String   @default("active") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([comicId])
  @@index([volumeId])
  @@index([giftId])
  @@index([status])
  @@map("listings")
}
